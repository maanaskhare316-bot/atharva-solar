# ==============================================================================
# Atharva Enterprises Solar - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your real .env file with secrets to version control.
# ==============================================================================

# Server Environment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS Security (set to your public domain in production, e.g., https://atharvasolar.com)
ALLOWED_ORIGIN=https://atharvasolar.com

# Database Path (optional - defaults to ./data/atharva.db)
# DB_PATH=./data/atharva.db

# Online Meeting Configuration
# Default prefix for generated Google Meet links
GOOGLE_MEET_PREFIX=https://meet.google.com/

# Email Notification Configuration (SMTP)
# When configured, meeting invitations and Google Meet links are emailed securely.
# If unconfigured, the server operates in simulated email mode (logged to console without leaking to client).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bookings@atharvasolar.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Atharva Enterprises Solar" <bookings@atharvasolar.com>
